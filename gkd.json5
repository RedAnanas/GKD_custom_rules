{
  "id": 2026102201,
  "name": "RedAnanas 的 GKD 自定义规则",
  "version": 3,
  "author": "RedAnanas",
  "apps": [
    {
      "id": "tv.danmaku.bili",
      "name": "哔哩哔哩",
      "groups": [
        {
          "key": 2026102201,
          "name": "视频广告-取消即将展示的广告",
          "enable": true,
          "activityIds": [
            "com.bilibili.ship.theseus.detail.UnitedBizDetailsActivity"
          ],
          "rules": [
            {
              "key": 0,
              "matches": "[text=\"后将展示广告\"] + [text=\"取消\"][clickable=true][visibleToUser=true]",
              "snapshotUrls": [
                "https://i.gkd.li/i/33820367"
              ]
            }
          ]
        },
        {
          "key": 2026102202,
          "name": "视频广告-关闭暂停广告面板",
          "enable": true,
          "activityIds": [
            "com.bilibili.ship.theseus.detail.UnitedBizDetailsActivity"
          ],
          "rules": [
            {
              "key": 0,
              "matches": "[desc=\"关闭暂停页\"][visibleToUser=true]",
              "snapshotUrls": [
                "https://i.gkd.li/i/33820404"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "com.diershoubing.erbing",
      "name": "二柄",
      "groups": [
        {
          "key": 2026102203,
          "name": "签到成功-关闭积分奖励弹窗",
          "enable": true,
          "activityIds": [
            ".activity.MainReActivity"
          ],
          "rules": [
            {
              "key": 0,
              "matches": "[text=\"签到成功\"] < [vid=\"mainV\"] + [vid=\"closeBtn\"][clickable=true][visibleToUser=true]",
              "snapshotUrls": [
                "https://i.gkd.li/i/33821065"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "com.netease.cloudmusic",
      "name": "网易云音乐",
      "groups": [
        {
          "key": 2026102204,
          "name": "会员推广-关闭黑胶到期续费弹窗",
          "enable": true,
          "activityIds": [
            ".music.biz.rn.activity.LayerReactNativeActivity"
          ],
          "rules": [
            {
              "key": 0,
              "matches": "[text^=\"您的黑胶VIP已过期\"] + ViewGroup[clickable=true][visibleToUser=true]",
              "snapshotUrls": [
                "https://i.gkd.li/i/33821416"
              ]
            }
          ]
        },
        {
          "key": 2026102205,
          "name": "会员推广-关闭付费歌曲推荐弹窗",
          "enable": true,
          "activityIds": [
            ".music.biz.rn.activity.LayerReactNativeActivity"
          ],
          "rules": [
            {
              "key": 0,
              "matches": "[text*=\"开会员无限畅听\"] <n ViewGroup + ViewGroup[clickable=true][visibleToUser=true]",
              "snapshotUrls": [
                "https://i.gkd.li/i/33821515"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "com.tencent.qqmusic",
      "name": "QQ音乐",
      "groups": [
        {
          "key": 2026102206,
          "name": "付费推广-关闭精美播放器弹窗",
          "enable": true,
          "activityIds": [
            ".activity.AppStarterActivity"
          ],
          "rules": [
            {
              "key": 0,
              "matches": "[text$=\"立享精美播放器\"] <n View - View > Image[visibleToUser=true]",
              "snapshotUrls": [
                "https://i.gkd.li/i/33821876"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "com.cmbchina.ccd.pluto.cmbActivity",
      "name": "掌上生活",
      "groups": [
        {
          "key": 2026102301,
          "name": "权限提示-关闭消息通知引导",
          "enable": true,
          "activityIds": [
            ".CMBRootActivityV2"
          ],
          "rules": [
            {
              "key": 0,
              "matches": [
                "[text=\"开启消息通知\"]",
                "[vid=\"iv_close\"][clickable=true][visibleToUser=true]"
              ],
              "snapshotUrls": [
                "https://i.gkd.li/i/33854044"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "com.ss.android.auto",
      "name": "懂车帝",
      "groups": [
        {
          "key": 2026102701,
          "name": "更新提示-30天内不再提示",
          "enable": true,
          "activityIds": [
            ".activity.UploadBrowserActivity"
          ],
          "rules": [
            {
              "key": 0,
              "name": "点击30天内不再提示",
              "actionMaximum": 1,
              "matches": [
                "[text=\"30天内不再提示\"]",
                "[vid=\"cyc\"] > ImageView[vid=\"bn7\"][clickable=true][visibleToUser=true]"
              ],
              "snapshotUrls": [
                "https://i.gkd.li/i/34015461"
              ]
            },
            {
              "key": 1,
              "name": "点击稍后再说",
              "preKeys": [0],
              "matches": "[vid=\"fou\"][text=\"稍后再说\"][clickable=true][visibleToUser=true]",
              "snapshotUrls": [
                "https://i.gkd.li/i/34015461"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "com.baidu.netdisk",
      "name": "百度网盘",
      "groups": [
        {
          "key": 2026102207,
          "name": "功能提示-暂不开启自动备份",
          "enable": true,
          "activityIds": [
            ".ui.RepeatedNewQuickSettingsActivity"
          ],
          "rules": [
            {
              "key": 0,
              "matches": "[vid=\"not_open\"][text=\"暂不开启\"][clickable=true][visibleToUser=true]",
              "snapshotUrls": [
                "https://i.gkd.li/i/33822082"
              ]
            },
            {
              "key": 1,
              "matches": "[vid=\"dialog_button_cancel\"][text=\"暂不开启\"][clickable=true][visibleToUser=true]",
              "snapshotUrls": [
                "https://i.gkd.li/i/33822183"
              ]
            }
          ]
        }
      ]
    }
  ]
}
